<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <GeneDef>
    <defName>TelolXenotype_Nocturnal</defName>
    <label>nocturnal</label>
    <labelShortAdj>nocturnal</labelShortAdj>
    <description>Carriers of this gene are adapted to nighttime and being outdoors during night activates their predatory instincts.</description>
    <iconPath>UI/Icons/Genes/Gene_TelolXenotype_Nocturnal</iconPath>
    <displayCategory>Miscellaneous</displayCategory>
    <displayOrderInCategory>60</displayOrderInCategory>
    <conditionalStatAffecters>
      <li Class="TelolRace.ConditionalStatAffecter_InDarknessOutside">
        <statOffsets>
          <WorkSpeedGlobal>0.25</WorkSpeedGlobal>
          <PlantWorkSpeed>0.25</PlantWorkSpeed>
          <HuntingStealth>0.5</HuntingStealth>
          <MoveSpeed>0.1</MoveSpeed>
        </statOffsets>
      </li>
    </conditionalStatAffecters>
    <biostatCpx>1</biostatCpx>
    <biostatMet>1</biostatMet>
    <forcedTraits>
      <li>
        <def>NightOwl</def>
      </li>
    </forcedTraits>
    <symbolPack>
      <prefixSymbols>
        <li><symbol>night</symbol></li>
        <li><symbol>dark</symbol></li>
        <li><symbol>noct</symbol></li>
      </prefixSymbols>
      <suffixSymbols>
        <li><symbol>prowl</symbol></li>
        <li><symbol>hunt</symbol></li>
      </suffixSymbols>
    </symbolPack>
  </GeneDef>

  <GeneDef>
    <defName>TelolXenotype_CognitiveInjuryResponse</defName>
    <label>cognitive injury response</label>
    <labelShortAdj>injury response</labelShortAdj>
    <description>When suffering catastrophic injury, a hardcoded cognitive response activates and the carrier of this gene adapts.</description>
    <iconPath>UI/Icons/Genes/Gene_TelolXenotype_CognitiveInjuryResponse</iconPath>
    <displayCategory>Miscellaneous</displayCategory>
    <displayOrderInCategory>60</displayOrderInCategory>
    <biostatCpx>2</biostatCpx>
    <biostatMet>-1</biostatMet>
    <customEffectDescriptions>
      <li>Permanent injury has a chance to grant beneficial survival-related trait.</li>
      <li>Traits considered: Nimble, Tough, Quick sleeper, Fast walker, Jogger, Steadfast, Iron-willed, Super-immune. (may include more if extended by mods)</li>
    </customEffectDescriptions>
    <symbolPack>
      <prefixSymbols>
        <li><symbol>evo</symbol></li>
        <li><symbol>fit</symbol></li>
        <li><symbol>adap</symbol></li>
        <li><symbol>chan</symbol></li>
      </prefixSymbols>
      <suffixSymbols>
        <li><symbol>hard</symbol></li>
        <li><symbol>fix</symbol></li>
      </suffixSymbols>
    </symbolPack>
  </GeneDef>

</Defs>